<div class="max-w-2xl mx-auto mt-10 p-6 bg-white rounded-xl shadow-md">
  <h1 class="text-2xl font-semibold mb-6">Create Full Product</h1>

  <%= form_with model: @product_form, url: create_full_products_path, local: true do |f| %>
    <% if @product_form.errors.any? %>
      <div class="mb-6 p-4 bg-red-100 text-red-700 rounded">
        <h2 class="font-bold"><%= pluralize(@product_form.errors.count, "error") %> prevented this product from being saved:</h2>
        <ul class="list-disc list-inside mt-2">
          <% @product_form.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Brand name -->
    <div class="mb-4">
      <%= f.label :brand_name, "Brand Name", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :brand_name, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring focus:ring-indigo-200" %>
    </div>

    <!-- Category name -->
    <div class="mb-4">
      <%= f.label :category_name, "Category Name", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :category_name, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring focus:ring-indigo-200" %>
    </div>

    <!-- Product name -->
    <div class="mb-4">
      <%= f.label :product_name, "Product Name", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :product_name, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring focus:ring-indigo-200" %>
    </div>

    <!-- Price -->
    <div class="mb-4">
      <%= f.label :price, "Price", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :price, step: 0.01, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring focus:ring-indigo-200" %>
    </div>

    <!-- Quantity -->
    <div class="mb-4">
      <%= f.label :quantity, "Quantity", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :quantity, step: 1, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring focus:ring-indigo-200" %>
    </div>

    <!-- Unit -->
    <div class="mb-4">
      <%= f.label :unit, "Unit", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :unit, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring focus:ring-indigo-200" %>
    </div>

    <!-- Submit -->
    <div class="mt-6">
      <%= f.submit "Create Full Product", class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-4 rounded-md transition duration-150" %>
    </div>
  <% end %>

  <div class="mt-4">
    <%= link_to "Back to products", products_path, class: "text-indigo-600 hover:underline text-sm" %>
  </div>
</div>
